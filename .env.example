MODEL_ORCHESTRATOR=
MODEL_AUDITOR=
MODEL_FAST=
MODEL_MULTIMODAL=
MODEL_EMBED=

# Tavily (News Scout)
TAVILY_API_KEY=

# Earth Engine (service account JSON path or inline JSON)
EE_SERVICE_ACCOUNT_JSON=

# Object storage (optional in week 1)
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
