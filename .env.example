# Copy to .env and fill in locally. Never commit .env.

# App
# development | test | production. The nx_session cookie drops Secure only when this is explicitly
# development or test; unset or anything else keeps it Secure (HTTPS). Every deployment MUST set
# ENVIRONMENT=production. The API logs a startup warning whenever the cookie is not Secure.
ENVIRONMENT=development
# Mock data and agents (no keys needed). The API refuses to start with USE_MOCKS=true when
# ENVIRONMENT=production: mock satellite metrics must never rate a real listing (T58).
USE_MOCKS=true
DEMO_MODE=true
LOCAL_JOBS=true
DATABASE_URL=postgresql+psycopg://naturex:naturex@localhost:5432/naturex
LLM_BUDGET_USD=20
EVENT_STREAM_MAX_CONCURRENT=40
# Create the live world at API startup if `make seed` hasn't; requests never create it (T73).
LIVE_WORLD_ON_STARTUP=true
RATING_RUNS_PER_WORLD_PER_HOUR=6
RATING_RUNS_GLOBAL_PER_HOUR=60
# >0: API-triggered rating runs skip the LLM once LLM_BUDGET_USD minus spend is below this
LLM_RESERVE_USD=0
# T75 monitoring jobs (rerate_all, news_sweep): each run stops before its own LLM spend could
# pass this (LLM_BUDGET_USD stays the global cap)
MONITOR_JOB_BUDGET_USD=2

# Auth hardening (T66)
# Exact origins (scheme://host[:port], comma separated) allowed to send POST, PUT, PATCH and DELETE.
# Required outside development and test (the API will not start without it); "*" is refused.
ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API that each append to X-Forwarded-For. 0 ignores the header.
# Count only proxies that really append (a platform load balancer or CDN). The Next.js /api
# rewrite does NOT, so it counts as 0. A value above the real number lets a client pick its own
# rate-limit bucket; a deployed API logs a warning while it is 0 (T20 decides the deployment).
TRUSTED_PROXY_HOPS=0
# HMAC key for the rate-limit buckets. Required unless ENVIRONMENT is development or test:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_RATE_LIMIT_SECRET=
# HMAC key for verification documents' private fingerprints (T69): catches one file backing two
# listings. Required unless ENVIRONMENT is development or test; generate it as above. Documents
# themselves are stored in Postgres (bytea), never on disk or in cloud storage.
DOCUMENT_FINGERPRINT_SECRET=
# Verification upload limits (T69): attempts per account per rolling hour, and the most document
# bytes the listings of one community, and of one world, may hold (100 MB and 1 GB).
DOCUMENT_UPLOADS_PER_HOUR=20
DOCUMENT_QUOTA_COMMUNITY_BYTES=104857600
DOCUMENT_QUOTA_WORLD_BYTES=1073741824

# Nebius Token Factory (NVIDIA Nemotron)
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_ORCHESTRATOR=nvidia/nemotron-3-super-120b-a12b
MODEL_AUDITOR=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MULTIMODAL=openbmb/MiniCPM-V-4_5
MODEL_EMBED=Qwen/Qwen3-Embedding-8B

# Tavily (News Scout)
TAVILY_API_KEY=
NOMINATIM_USER_AGENT=NatureX/0.1 (https://github.com/melvin1117/naturex)

# Earth Engine (service account JSON path or inline JSON)
EE_SERVICE_ACCOUNT_JSON=
# T60: rate new live-world listings with live Earth Engine metrics (needs EE_SERVICE_ACCOUNT_JSON).
# Off in tests and CI. Results are cached per polygon, so a polygon is computed once per data
# version.
EARTH_ENGINE_LIVE=false
# Seconds a run waits for a free slot, then seconds the computation may take (max 400).
EARTH_ENGINE_TIMEOUT_S=120
# Computations at once, per API process (the daily quotas below are global).
EARTH_ENGINE_MAX_CONCURRENT=1
# Larger listings are never computed live (409 live_area_too_large at submit).
EARTH_ENGINE_LIVE_MAX_HA=5000
# Live-world live ratings (submits that need a computation; cached polygons are free; demo
# sandboxes never compute) per rolling 24 hours: per account, and in total. 429 after;
# LLM_BUDGET_USD stays the hard cap on the runs' model calls.
LIVE_RATINGS_PER_USER_PER_DAY=2
LIVE_RATINGS_GLOBAL_PER_DAY=50

# Object storage (optional in week 1)
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Frontend: where Next.js proxies /api/* (server-side only)
BACKEND_URL=http://localhost:8000
