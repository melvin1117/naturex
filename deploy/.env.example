# The deployed app's settings (docs/deploy.md). On the VM: cp deploy/.env.example deploy/.env,
# chmod 600 deploy/.env, then fill it in. Never commit deploy/.env. Every setting the app reads
# is described in the repo-root .env.example; this file sets the production values.

# --- Address ---------------------------------------------------------------------------------
# What Caddy serves: a domain (HTTPS is automatic), e.g. wildworth.westus2.cloudapp.azure.com.
# For a local try: SITE_ADDRESS=http://localhost:8088 with HTTP_PORT=8088 and HTTPS_PORT=8443.
SITE_ADDRESS=wildworth.example.org
SITE_URL=https://wildworth.example.org
ALLOWED_ORIGINS=https://wildworth.example.org
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Database ----------------------------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# --- App -----------------------------------------------------------------------------------------
ENVIRONMENT=production
USE_MOCKS=false
EARTH_ENGINE_LIVE=true
DEMO_MODE=true
LOCAL_JOBS=true
LIVE_WORLD_ON_STARTUP=true
# Caddy is the one proxy that appends X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Each: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_RATE_LIMIT_SECRET=
DOCUMENT_FINGERPRINT_SECRET=

# --- Nebius Token Factory -----------------------------------------------------------------------
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_ORCHESTRATOR=nvidia/nemotron-3-super-120b-a12b
MODEL_AUDITOR=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MULTIMODAL=nvidia/Nemotron-3.5-Super-VL
MODEL_EMBED=Qwen/Qwen3-Embedding-8B
SITE_VISION_LIVE=true
# The hard cap counts every call logged in this database, including the ones that came with the
# imported data (about $1.40), so it's that plus the deployment's own slice; $2 is kept for judging.
LLM_BUDGET_USD=16.5
LLM_RESERVE_USD=2

# --- Tavily (News Scout) -------------------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_MIN_CREDITS_LEFT=50

# --- Earth Engine --------------------------------------------------------------------------------
# The key itself goes in deploy/secrets/ee-service-account.json (compose.yml mounts it).
EARTH_ENGINE_TIMEOUT_S=120
EARTH_ENGINE_MAX_CONCURRENT=1
EARTH_ENGINE_LIVE_MAX_HA=5000

# --- Visitors' sandboxes -------------------------------------------------------------------------
SANDBOX_LLM_BUDGET_USD=0.5
SANDBOX_LLM_BUDGET_PER_HOUR_USD=3
SANDBOX_LIVE_RATINGS_PER_DAY=20
SANDBOX_LIVE_RATINGS_PER_WORLD_PER_DAY=3
DEMO_STARTS_PER_IP_PER_HOUR=20

NOMINATIM_USER_AGENT=WildWorth/0.1 (https://github.com/melvin1117/wildworth)
